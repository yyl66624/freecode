{
  // FreeCode routing configuration.
  //
  // `pool` maps a capability tier to the models that satisfy it, in preference
  // order. Laya decides which tier a task needs; the pool decides which of the
  // models this user actually has is used for it.
  //
  // `broken` is a deliberately unusable account: its key is invalid, so the
  // provider answers 401. It exists to exercise runtime failover — the scheduler
  // must exclude it after the first failure and continue on a healthy account
  // without consuming a Head agent turn.
  "$schema": "https://opencode.ai/config.json",
  "freecode": {
    "pool": {
      "local": ["deepseek/deepseek-flash"],
      "fast": ["deepseek/deepseek-flash"],
      "standard": ["broken/deepseek-chat", "deepseek/deepseek-v4-pro"],
      "strong": ["broken/deepseek-chat", "deepseek/deepseek-v4-pro"],
      "max": ["broken/deepseek-chat", "deepseek/deepseek-v4-pro"]
    }
  },
  "provider": {
    "broken": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Broken Account (failover probe)",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "sk-invalid-key-for-failover-testing"
      },
      "models": {
        "deepseek-chat": { "name": "Broken DeepSeek" }
      }
    },
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com/v1",
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      },
      "models": {
        "deepseek-flash": { "name": "DeepSeek Flash" },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro" }
      }
    }
  },
  "model": "deepseek/deepseek-v4-pro"
}
